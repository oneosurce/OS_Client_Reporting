/// One row per Syncro-managed endpoint seen in the last 90 days. Hardware / OS / health
/// facts are parsed from the asset `properties` JSON at refresh time. Is Active = seen in
/// the last 30 days; Is Stale = last seen 31-90 days ago (went dark, worth a look).
table Assets
	lineageTag: fa000001-0000-4001-b001-000000000001

	column 'Device Name'
		dataType: string
		lineageTag: fa000001-0000-4001-b001-000000000002
		summarizeBy: none
		sourceColumn: Device Name

		annotation SummarizationSetBy = User

	column Client
		dataType: string
