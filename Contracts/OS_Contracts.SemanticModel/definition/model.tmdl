model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Clients","Contracts","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Clients
ref table Contracts
ref table _Measures

ref cultureInfo en-US
