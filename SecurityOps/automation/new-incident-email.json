{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": { "type": "string", "defaultValue": "OS-Sentinel-NewIncident-Email" },
    "notifyEmail": { "type": "string", "defaultValue": "ar@onesource.tech" },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" }
  },
  "variables": {
    "sentinelConn": "azuresentinel-os",
    "officeConn": "office365-os",
    "managedApiBase": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConn')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConn')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": { "id": "[concat(variables('managedApiBase'), 'azuresentinel')]" }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('officeConn')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[parameters('notifyEmail')]",
        "customParameterValues": {},
        "api": { "id": "[concat(variables('managedApiBase'), 'office365')]" }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConn'))]",
        "[resourceId('Microsoft.Web/connections', variables('officeConn'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" },
            "NotifyEmail": { "defaultValue": "", "type": "String" }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": { "callback_url": "@{listCallbackUrl()}" },
                "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Send_incident_email": {
              "type": "ApiConnection",
              "inputs": {
                "method": "post",
                "path": "/v2/Mail",
                "host": { "connection": { "name": "@parameters('$connections')['office365']['connectionId']" } },
                "body": {
                  "To": "@parameters('NotifyEmail')",
                  "Importance": "High",
                  "Subject": "@{concat('Sentinel incident #', string(triggerBody()?['object']?['properties']?['incidentNumber']), ' (', triggerBody()?['object']?['properties']?['severity'], '): ', triggerBody()?['object']?['properties']?['title'])}",
                  "Body": "<html><body style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#1F2A5A\"><h2 style=\"margin:0 0 8px 0\">@{triggerBody()?['object']?['properties']?['title']}</h2><table cellpadding=\"4\" style=\"border-collapse:collapse\"><tr><td><b>Incident</b></td><td>#@{triggerBody()?['object']?['properties']?['incidentNumber']} (provider ID @{coalesce(triggerBody()?['object']?['properties']?['providerIncidentId'], 'n/a')})</td></tr><tr><td><b>Severity</b></td><td>@{triggerBody()?['object']?['properties']?['severity']}</td></tr><tr><td><b>Status</b></td><td>@{triggerBody()?['object']?['properties']?['status']}</td></tr><tr><td><b>Created (UTC)</b></td><td>@{triggerBody()?['object']?['properties']?['createdTimeUtc']}</td></tr><tr><td><b>Tactics</b></td><td>@{join(coalesce(triggerBody()?['object']?['properties']?['additionalData']?['tactics'], createArray()), ', ')}</td></tr><tr><td><b>Alerts</b></td><td>@{coalesce(triggerBody()?['object']?['properties']?['additionalData']?['alertsCount'], 0)}</td></tr><tr><td><b>Workspace</b></td><td>@{coalesce(triggerBody()?['workspaceInfo']?['WorkspaceName'], triggerBody()?['workspaceInfo']?['workspaceName'], 'n/a')}</td></tr></table><p style=\"margin-top:12px\">@{substring(string(coalesce(triggerBody()?['object']?['properties']?['description'], ' ')), 0, min(length(string(coalesce(triggerBody()?['object']?['properties']?['description'], ' '))), 600))}</p><p><a href=\"@{triggerBody()?['object']?['properties']?['incidentUrl']}\">Open this incident in Microsoft Sentinel</a></p></body></html>"
                }
              },
              "runAfter": {}
            }
          },
          "outputs": {}
        },
        "parameters": {
          "NotifyEmail": { "value": "[parameters('notifyEmail')]" },
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConn'))]",
                "connectionName": "[variables('sentinelConn')]",
                "id": "[concat(variables('managedApiBase'), 'azuresentinel')]",
                "connectionProperties": { "authentication": { "type": "ManagedServiceIdentity" } }
              },
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('officeConn'))]",
                "connectionName": "[variables('officeConn')]",
                "id": "[concat(variables('managedApiBase'), 'office365')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppPrincipalId": { "type": "string", "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]" }
  }
}
