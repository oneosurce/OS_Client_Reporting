expression CentralWorkspaceId = "046d4a05-36e4-4b43-a67a-309741cfc1c7" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 11111111-0000-0000-0000-000000000001

	annotation PBI_ResultType = Text

expression fnBuildUnion =
		(tableName as text) as text =>
				let
						Central      = Table.SelectRows(TenantRegistry, each [IsManagingWorkspace] = true){0},
						Members      = Table.SelectRows(TenantRegistry, each [IsManagingWorkspace] = false),
						CentralPart  = "    (" & tableName & " | extend ClientWorkspace = """ & Central[ClientName] & """)",
						MemberParts  = List.Transform(
								Table.ToRows(Table.SelectColumns(Members, {"WorkspaceResourceId", "ClientName"})),
								each "    (workspace(""" & _{0} & """)." & tableName & " | extend ClientWorkspace = """ & _{1} & """)"
						),
						AllParts     = List.Combine({{CentralPart}, MemberParts}),
						UnionKQL     = "union" & "#(lf)" & Text.Combine(AllParts, "," & "#(lf)")
				in
						UnionKQL
	lineageTag: 11111111-0000-0000-0000-000000000002

	annotation PBI_ResultType = Function

expression fnQueryLogAnalytics =
		(kqlQuery as text) as table =>
				let
						Result = AzureDataExplorer.Contents(
								"https://ade.loganalytics.io/subscriptions/42a6ebff-536a-4d2a-ba20-43225526bef8/resourcegroups/Sentinel/providers/microsoft.operationalinsights/workspaces/OS-Sentinel-0",
								"OS-Sentinel-0",
								kqlQuery,
								[MaxRows=null, MaxSize=null, NoTruncate=true, AdditionalSetStatements=null]
						)
				in
						Result
	lineageTag: 11111111-0000-0000-0000-000000000003

	annotation PBI_ResultType = Function

