model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["TenantRegistry","Incidents","IncidentTactics","Alerts","IdentityThreats","ThreatIntelMatches","AzureActivityEvents","RulesFired","Date","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.135.7952.0 (24.11)

ref table TenantRegistry
ref table Incidents
ref table IncidentTactics
ref table Alerts
ref table IdentityThreats
ref table ThreatIntelMatches
ref table AzureActivityEvents
ref table RulesFired
ref table Date
ref table _Measures

ref cultureInfo en-US

