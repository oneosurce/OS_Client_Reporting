table UEBAInsights
	lineageTag: b1000000-0000-0000-0000-000000000001

	column Reason
		dataType: string
		lineageTag: b1000001-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Reason

		annotation SummarizationSetBy = User

	column UserPrincipalName
		dataType: string
		lineageTag: b1000002-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: UserPrincipalName

		annotation SummarizationSetBy = User

	column InvestigationPriority
		dataType: int64
		formatString: 0
		lineageTag: b1000003-0000-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: InvestigationPriority

		annotation SummarizationSetBy = User

	column EventDate
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: b1000004-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventDate

		annotation SummarizationSetBy = User

	column ClientWorkspace
		dataType: string
		lineageTag: b1000005-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition UEBAInsights = m
		mode: import
		source =
				let
					QueryOne = (wsRid as text, isCentral as logical, clientName as text) as any =>
						let
							Tbl = if isCentral then "BehaviorAnalytics" else "workspace(""" & wsRid & """).BehaviorAnalytics",
							KQL = Tbl
								& "#(lf)| where TimeGenerated > ago(90d) and InvestigationPriority > 0"
								& "#(lf)| mv-expand bagexpansion=array ActivityInsights"
								& "#(lf)| extend ReasonKey = tostring(ActivityInsights[0]), ReasonVal = tostring(ActivityInsights[1])"
								& "#(lf)| where ReasonVal == ""True"""
								& "#(lf)| extend Reason = case(ReasonKey == ""FirstTimeUserUsedApp"", ""First time user used app"", ReasonKey == ""FirstTimeUserAccessedResource"", ""First time user accessed resource"", ReasonKey == ""FirstTimeUserConnectedFromCountry"", ""First connection from country (user)"", ReasonKey == ""FirstTimeConnectionFromCountryObservedInTenant"", ""First connection from country (tenant)"", ReasonKey == ""CountryUncommonlyConnectedFromInTenant"", ""Country uncommon for tenant"", ReasonKey == ""CountryUncommonlyConnectedFromAmongPeers"", ""Country uncommon among peers"", ReasonKey == ""FirstTimeUserConnectedViaISP"", ""First connection via ISP (user)"", ReasonKey == ""FirstTimeConnectionViaISPInTenant"", ""First connection via ISP (tenant)"", ReasonKey == ""FirstTimeUserConnectedViaBrowser"", ""First connection via browser"", ReasonKey == ""FirstTimeDeviceObservedInTenant"", ""First time device in tenant"", ReasonKey == ""ResourceUncommonlyAccessedByUser"", ""Resource uncommon for user"", ReasonKey == ""ResourceUncommonlyAccessedInTenant"", ""Resource uncommon for tenant"", ReasonKey == ""ResourceUncommonlyAccessedAmongPeers"", ""Resource uncommon among peers"", ReasonKey == ""AppUncommonlyUsedAmongPeers"", ""App uncommon among peers"", ReasonKey == ""AppIdUncommonlyAccessedInTenant"", ""App uncommon for tenant"", ReasonKey == ""ActionUncommonlyPerformedByUser"", ""Action uncommon for user"", ReasonKey == ""UncommonHighVolumeOfActions"", ""Unusually high volume of actions"", ReasonKey)"
								& "#(lf)| extend ClientWorkspace = """ & clientName & """"
								& "#(lf)| project Reason, UserPrincipalName, InvestigationPriority, EventDate = bin(TimeGenerated, 1d), ClientWorkspace",
							Result = try Table.Buffer(fnQueryLogAnalytics(KQL)) otherwise null
						in
							Result,
					WithQ = Table.AddColumn(TenantRegistry, "Q", each QueryOne([WorkspaceResourceId], [IsManagingWorkspace], [ClientName])),
					NonNull = Table.SelectRows(WithQ, each [Q] <> null),
					Combined = Table.Combine(NonNull[Q]),
					Typed = Table.TransformColumnTypes(Combined, {
						{"InvestigationPriority", Int64.Type},
						{"EventDate",             type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table
