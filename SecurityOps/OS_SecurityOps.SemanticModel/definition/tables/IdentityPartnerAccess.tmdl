	column ClientWorkspace
		dataType: string
		lineageTag: c30000010-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition IdentityPartnerAccess = m
		mode: import
		source =
				let
					Tail = "#(lf)| where TimeGenerated > ago(90d)" &
							"#(lf)| where CrossTenantAccessType == ""serviceProvider"" and HomeTenantId != AADTenantId" &
							"#(lf)| summarize Events=count(), Successes=countif(ResultType == ""0"") by PartnerTenantId=HomeTenantId, PartnerUser=UserPrincipalName, Country=Location, AuthRequirement=AuthenticationRequirement, ResultCode=tostring(ResultType), EventDate=bin(TimeGenerated, 1d)",
					NonInt = fnQueryEach("AADNonInteractiveUserSignInLogs", Tail),
					Int = fnQueryEach("SigninLogs", Tail),
					Combined = Table.Combine({NonInt, Int}),
					Names = [#"3de67d67-88e8-42c0-88ea-13bfc2fc2f55" = "Pax8", #"d3cf3dfe-05a1-4069-aa10-6b6d4fc51b12" = "YourHelpDeskHQ", #"4b5e91ed-2885-49b3-9d58-a87089c51417" = "OneSource (MSP)"],
					Named = Table.AddColumn(Combined, "PartnerName", each Record.FieldOrDefault(Names, [PartnerTenantId], "Unknown partner (" & Text.Start([PartnerTenantId], 8) & ")"), type text),
					Typed = Table.TransformColumnTypes(Named, {
						{"Events", Int64.Type},
						{"Successes", Int64.Type},
						{"EventDate", type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table
