	column Successes
		dataType: int64
		formatString: 0
		lineageTag: c30000008-0000-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: Successes

		annotation SummarizationSetBy = User

	column EventDate
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: c30000009-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventDate

