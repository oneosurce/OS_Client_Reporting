table IdentityPartnerAccess
	lineageTag: c3000000-0000-0000-0000-000000000001

	column PartnerName
		dataType: string
		lineageTag: c30000001-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: PartnerName

		annotation SummarizationSetBy = User

	column PartnerTenantId
		dataType: string
		lineageTag: c30000002-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: PartnerTenantId

		annotation SummarizationSetBy = User

	column PartnerUser
		dataType: string
		lineageTag: c30000003-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: PartnerUser

		annotation SummarizationSetBy = User

	column Country
		dataType: string
		lineageTag: c30000004-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = User

	column AuthRequirement
		dataType: string
		lineageTag: c30000005-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: AuthRequirement

		annotation SummarizationSetBy = User

	column ResultCode
		dataType: string
		lineageTag: c30000006-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ResultCode

		annotation SummarizationSetBy = User

	column Events
		dataType: int64
		formatString: 0
		lineageTag: c30000007-0000-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: Events

