/// Alerts triggered by Threat Intelligence analytics rules across all workspaces.
/// Identified by alert names that start with "TI map".
table ThreatIntelMatches
	lineageTag: 55555555-0000-0000-0000-000000000001

	column AlertName
		dataType: string
		lineageTag: 55555555-0001-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: AlertName
		annotation SummarizationSetBy = User

	column IndicatorType
		dataType: string
		lineageTag: 55555555-0002-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: IndicatorType
		annotation SummarizationSetBy = User

	column Severity
		dataType: string
		lineageTag: 55555555-0003-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Severity
		annotation SummarizationSetBy = User

	column MatchedEntity
		dataType: string
		lineageTag: 55555555-0004-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: MatchedEntity
		annotation SummarizationSetBy = User

	column AlertTime
		dataType: dateTime
		formatString: General Date
		lineageTag: 55555555-0005-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: AlertTime
		annotation SummarizationSetBy = User

	column AlertDate
		dataType: dateTime
		formatString: Short Date
		isHidden
		lineageTag: 55555555-0005-0001-0000-000000000001
		summarizeBy: none
		sourceColumn: AlertDate
		annotation SummarizationSetBy = User

	column ClientWorkspace
		dataType: string
		lineageTag: 55555555-0006-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace
		annotation SummarizationSetBy = User

	partition ThreatIntelMatches = m
		mode: import
		source =
				let
					KQL = fnBuildUnion("SecurityAlert") & "
| where TimeGenerated > ago(30d)
| where AlertName startswith ""TI map"" or AlertName startswith ""TI Map""
| extend IndicatorType = case(
    AlertName has ""IP"",    ""IP Address"",
    AlertName has ""Email"", ""Email"",
    AlertName has ""URL"",   ""URL"",
    AlertName has ""Domain"",""Domain"",
    AlertName has ""Hash"",  ""File Hash"",
    ""Other"")
| extend MatchedEntity = tostring(Entities)
| project AlertName, IndicatorType, AlertSeverity, MatchedEntity,
    AlertTime = StartTime, AlertDate = bin(StartTime, 1d), ClientWorkspace
| rename Severity = AlertSeverity",
					Source = AzureLogAnalytics.Contents(
						CentralWorkspaceId,
						[Query = KQL, Timeout = #duration(0, 0, 4, 0)]
					),
					Typed = Table.TransformColumnTypes(Source, {
						{"AlertTime", type datetime},
						{"AlertDate", type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table

