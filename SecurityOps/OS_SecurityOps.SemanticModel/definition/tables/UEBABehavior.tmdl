table UEBABehavior
	lineageTag: b0000000-0000-0000-0000-000000000001

	column EventTime
		dataType: dateTime
		formatString: General Date
		lineageTag: b0000001-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventTime

		annotation SummarizationSetBy = User

	column EventDate
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: b0000002-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventDate

		annotation SummarizationSetBy = User

