	column ActivityType
		dataType: string
		lineageTag: b0000004-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ActivityType

		annotation SummarizationSetBy = User

	column ActionType
		dataType: string
		lineageTag: b0000005-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ActionType

