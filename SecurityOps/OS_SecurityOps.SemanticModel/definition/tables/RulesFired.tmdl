table RulesFired
	lineageTag: 77777777-0000-0000-0000-000000000001

	column RuleName
		dataType: string
		lineageTag: 77777777-0001-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: RuleName

		annotation SummarizationSetBy = User

	column Severity
		dataType: string
		lineageTag: 77777777-0002-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Severity

		annotation SummarizationSetBy = User

	column FiringCount
		dataType: int64
		formatString: 0
		lineageTag: 77777777-0003-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: FiringCount

		annotation SummarizationSetBy = User

	column LastFired
		dataType: dateTime
		formatString: General Date
		lineageTag: 77777777-0004-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: LastFired

		annotation SummarizationSetBy = User

	column FiringDate
		dataType: dateTime
		formatString: Short Date
		isHidden
		lineageTag: 77777777-0004-0001-0000-000000000001
		summarizeBy: none
		sourceColumn: FiringDate

		annotation SummarizationSetBy = User

	column ClientWorkspace
		dataType: string
		lineageTag: 77777777-0005-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition RulesFired = m
		mode: import
		source =
				let
					KQL = fnBuildUnion("SecurityAlert")
						& "#(lf)| where TimeGenerated > ago(30d)"
						& "#(lf)| where AlertType !startswith ""TI map"" and AlertType !startswith ""TI Map"""
						& "#(lf)| summarize FiringCount = count(), LastFired = max(TimeGenerated) by RuleName = AlertName, Severity = AlertSeverity, FiringDate = bin(TimeGenerated, 1d), ClientWorkspace",
					Source = fnQueryLogAnalytics(KQL),
					Typed = Table.TransformColumnTypes(Source, {
						{"FiringCount", Int64.Type},
						{"LastFired",   type datetime},
						{"FiringDate",  type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table

