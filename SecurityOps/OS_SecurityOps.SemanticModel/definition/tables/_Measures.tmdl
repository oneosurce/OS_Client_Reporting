table _Measures
	lineageTag: 00000000-ffff-0000-0000-000000000001
	isHidden

	measure 'Total Incidents' =
			COALESCE(COUNTROWS(Incidents), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0001-0000-000000000001

	measure 'Open Incidents' =
			COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[Status] = "New" || Incidents[Status] = "Active"), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0002-0000-000000000001

	measure 'High Severity Incidents' =
			COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[Severity] = "High"), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0003-0000-000000000001

	measure 'New Incidents' =
			COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[Status] = "New"), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0016-0000-000000000001

	measure 'Closed Incidents' =
			COALESCE(CALCULATE(COUNTROWS(Incidents), Incidents[Status] = "Closed"), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0017-0000-000000000001

	measure 'Avg Resolution Hours' =
			COALESCE(AVERAGEX(FILTER(Incidents, NOT ISBLANK(Incidents[ResolutionHours])), Incidents[ResolutionHours]), 0)
		formatString: 0.0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0004-0000-000000000001

	measure 'Total Alerts' =
			COALESCE(COUNTROWS(Alerts), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0005-0000-000000000001

	measure 'Tenants Monitored' =
			COALESCE(DISTINCTCOUNT(Incidents[ClientWorkspace]), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0006-0000-000000000001

	measure 'Failed Sign-ins' =
			COALESCE(
				CALCULATE(
					SUMX(IdentityThreats, IdentityThreats[EventCount]),
					IdentityThreats[EventType] <> "Brute Force" &&
					IdentityThreats[EventType] <> "MFA Disabled" &&
					IdentityThreats[EventType] <> "MFA Method Removed" &&
					IdentityThreats[EventType] <> "MFA Rejected"
				), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0007-0000-000000000001

	measure 'Brute Force Events' =
			COALESCE(CALCULATE(COUNTROWS(IdentityThreats), IdentityThreats[EventType] = "Brute Force"), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0008-0000-000000000001

	measure 'MFA Changes' =
			COALESCE(
				CALCULATE(
					SUMX(IdentityThreats, IdentityThreats[EventCount]),
					IdentityThreats[EventType] = "MFA Disabled" ||
					IdentityThreats[EventType] = "MFA Method Removed" ||
					IdentityThreats[EventType] = "MFA Rejected"
				), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0009-0000-000000000001

	measure 'TI Matches' =
			COALESCE(COUNTROWS(ThreatIntelMatches), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0010-0000-000000000001

	measure 'Identity Events' =
			COALESCE(SUM(IdentityThreats[EventCount]), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0018-0000-000000000001

	measure 'Unique Targeted Users' =
			COALESCE(
				CALCULATE(
					DISTINCTCOUNT(IdentityThreats[UserPrincipalName]),
					IdentityThreats[UserPrincipalName] <> ""
				), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0019-0000-000000000001

	measure 'Source Countries' =
			COALESCE(
				CALCULATE(
					DISTINCTCOUNT(IdentityThreats[Country]),
					IdentityThreats[Country] <> ""
				), 0)
		formatString: 0
		displayFolder: Threat Activity
		lineageTag: 00000000-ffff-0020-0000-000000000001

	measure 'Tactic Count' =
			COALESCE(COUNTROWS(IncidentTactics), 0)
		formatString: 0
		displayFolder: SOC Overview
		lineageTag: 00000000-ffff-0021-0000-000000000001

	measure 'Rules Fired (30d)' =
			COALESCE(SUMX(RulesFired, RulesFired[FiringCount]), 0)
		formatString: 0
		displayFolder: Security Posture
		lineageTag: 00000000-ffff-0011-0000-000000000001

	measure 'Distinct Rules Active' =
			COALESCE(DISTINCTCOUNT(RulesFired[RuleName]), 0)
		formatString: 0
		displayFolder: Security Posture
		lineageTag: 00000000-ffff-0012-0000-000000000001

	measure 'Azure Activity Events' =
			COALESCE(COUNTROWS(AzureActivityEvents), 0)
		formatString: 0
		displayFolder: Security Posture
		lineageTag: 00000000-ffff-0013-0000-000000000001

	measure 'Incidents Δ% (15d)' =
			VAR CurrP = COALESCE(CALCULATE([Total Incidents], DATESINPERIOD('Date'[Date], LASTDATE('Date'[Date]), -15, DAY)), 0)
			VAR PrevP = COALESCE(CALCULATE([Total Incidents], DATESINPERIOD('Date'[Date], LASTDATE('Date'[Date]) - 15, -15, DAY)), 0)
			RETURN SWITCH(TRUE(), PrevP = 0 && CurrP = 0, 0, PrevP = 0, 1, DIVIDE(CurrP - PrevP, PrevP))
		formatString: 0%;-0%;0%
		displayFolder: Trends
		lineageTag: 00000000-ffff-0014-0000-000000000001

	measure 'Alerts Δ% (15d)' =
			VAR CurrP = COALESCE(CALCULATE([Total Alerts], DATESINPERIOD('Date'[Date], LASTDATE('Date'[Date]), -15, DAY)), 0)
			VAR PrevP = COALESCE(CALCULATE([Total Alerts], DATESINPERIOD('Date'[Date], LASTDATE('Date'[Date]) - 15, -15, DAY)), 0)
			RETURN SWITCH(TRUE(), PrevP = 0 && CurrP = 0, 0, PrevP = 0, 1, DIVIDE(CurrP - PrevP, PrevP))
		formatString: 0%;-0%;0%
		displayFolder: Trends
		lineageTag: 00000000-ffff-0015-0000-000000000001

	measure 'UEBA Scored Events' =
			COALESCE(COUNTROWS(UEBABehavior), 0)
		formatString: 0
		displayFolder: UEBA
		lineageTag: 00000000-ffff-0030-0000-000000000001

	measure 'UEBA Flagged Users' =
			COALESCE(DISTINCTCOUNT(UEBABehavior[UserPrincipalName]), 0)
		formatString: 0
		displayFolder: UEBA
		lineageTag: 00000000-ffff-0031-0000-000000000001

	measure 'UEBA High Priority' =
			COALESCE(CALCULATE(COUNTROWS(UEBABehavior), UEBABehavior[InvestigationPriority] >= 4), 0)
		formatString: 0
		displayFolder: UEBA
		lineageTag: 00000000-ffff-0032-0000-000000000001

	measure 'UEBA Risk Score' =
			COALESCE(SUM(UEBABehavior[InvestigationPriority]), 0)
		formatString: 0
		displayFolder: UEBA
		lineageTag: 00000000-ffff-0033-0000-000000000001

	measure 'UEBA Anomaly Flags' =
			COALESCE(COUNTROWS(UEBAInsights), 0)
		formatString: 0
		displayFolder: UEBA
		lineageTag: 00000000-ffff-0034-0000-000000000001

	measure 'Legacy Auth Sign-ins' =
			COALESCE(SUM(IdentityLegacyAuth[Events]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0100-0000-000000000001

	measure 'Legacy Auth Successes' =
			COALESCE(SUM(IdentityLegacyAuth[Successes]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0101-0000-000000000001

	measure 'Legacy Auth Users' =
			COALESCE(DISTINCTCOUNT(IdentityLegacyAuth[UserPrincipalName]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0102-0000-000000000001

	measure 'CA Sign-ins' =
			COALESCE(SUM(IdentityCA[Events]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0103-0000-000000000001

	measure 'CA Not Applied' =
			COALESCE(CALCULATE(SUM(IdentityCA[Events]), IdentityCA[CAStatus] = "notApplied"), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0104-0000-000000000001

	measure 'CA Blocked' =
			COALESCE(CALCULATE(SUM(IdentityCA[Events]), IdentityCA[CAStatus] = "failure"), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0105-0000-000000000001

	measure 'CA Coverage %' =
			VAR Total = SUM(IdentityCA[Events])
			VAR NotApplied = CALCULATE(SUM(IdentityCA[Events]), IdentityCA[CAStatus] = "notApplied")
			RETURN IF(Total = 0, 0, DIVIDE(Total - NotApplied, Total))
		formatString: 0%
		displayFolder: Identity
		lineageTag: 00000000-ffff-0106-0000-000000000001

	measure 'Partner Sessions' =
			COALESCE(SUM(IdentityPartnerAccess[Events]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0107-0000-000000000001

	measure 'Partner Successes' =
			COALESCE(SUM(IdentityPartnerAccess[Successes]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0108-0000-000000000001

	measure 'Partner Failures' =
			[Partner Sessions] - [Partner Successes]
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0109-0000-000000000001

	measure 'SP Sign-ins' =
			COALESCE(SUM(IdentitySPHealth[Events]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0110-0000-000000000001

	measure 'SP Failures' =
			COALESCE(SUM(IdentitySPHealth[Failures]), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0111-0000-000000000001

	measure 'SP Failure Rate' =
			DIVIDE([SP Failures], [SP Sign-ins], 0)
		formatString: 0%
		displayFolder: Identity
		lineageTag: 00000000-ffff-0112-0000-000000000001

	measure 'Failing Apps' =
			COALESCE(SUMX(VALUES(IdentitySPHealth[AppName]), IF([SP Sign-ins] >= 10 && DIVIDE([SP Failures], [SP Sign-ins]) >= 0.5, 1, 0)), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0113-0000-000000000001

	measure 'Directory Changes' =
			COALESCE(COUNTROWS(IdentityChanges), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0114-0000-000000000001

	measure 'Risky Sign-ins' =
			COALESCE(COUNTROWS(IdentityRisk), 0)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0115-0000-000000000001

	measure 'SP Failed' =
			VAR f = SUM(IdentitySPHealth[Failures])
			RETURN IF(f = 0, BLANK(), f)
		formatString: 0
		displayFolder: Identity
		lineageTag: 00000000-ffff-0116-0000-000000000001

	column Column
		dataType: string
		isHidden
		lineageTag: 00000000-ffff-c001-0000-000000000001
		summarizeBy: none
		sourceColumn: Column

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table [Column = text], {})
				in
					Source

	annotation PBI_ResultType = Table

