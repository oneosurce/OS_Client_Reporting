table IdentityLegacyAuth
	lineageTag: c1000000-0000-0000-0000-000000000001

	column Protocol
		dataType: string
		lineageTag: c10000001-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Protocol

		annotation SummarizationSetBy = User

	column UserPrincipalName
		dataType: string
		lineageTag: c10000002-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: UserPrincipalName

		annotation SummarizationSetBy = User

	column Events
		dataType: int64
		formatString: 0
		lineageTag: c10000003-0000-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: Events

		annotation SummarizationSetBy = User

	column Successes
		dataType: int64
		formatString: 0
		lineageTag: c10000004-0000-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: Successes

		annotation SummarizationSetBy = User

	column EventDate
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: c10000005-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventDate

		annotation SummarizationSetBy = User

	column ClientWorkspace
		dataType: string
		lineageTag: c10000006-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition IdentityLegacyAuth = m
		mode: import
		source =
				let
					Tail = "#(lf)| where TimeGenerated > ago(90d)" &
							"#(lf)| where ClientAppUsed !in (""Browser"",""Mobile Apps and Desktop clients"",""Unknown"","""")" &
							"#(lf)| summarize Events=count(), Successes=countif(ResultType == ""0"") by Protocol=ClientAppUsed, UserPrincipalName, EventDate=bin(TimeGenerated, 1d)",
					Source = fnQueryEach("SigninLogs", Tail),
					Typed = Table.TransformColumnTypes(Source, {
						{"Events", Int64.Type},
						{"Successes", Int64.Type},
						{"EventDate", type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table
