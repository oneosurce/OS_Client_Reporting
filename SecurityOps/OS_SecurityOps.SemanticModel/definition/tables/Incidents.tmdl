	column ResolutionHours
		dataType: double
		formatString: 0.0
		lineageTag: 33333333-0014-0000-0000-000000000001
		summarizeBy: average
		sourceColumn: ResolutionHours

		annotation SummarizationSetBy = User

	partition Incidents = m
		mode: import
		source =
				let
					KQL = fnBuildUnion("SecurityIncident")
						& "#(lf)| where TimeGenerated > ago(30d)"
						& "#(lf)| extend SeveritySort = case(Severity == ""High"", 1, Severity == ""Medium"", 2, Severity == ""Low"", 3, 4)"
						& "#(lf)| extend Owner = tostring(Owner.assignedTo)"
						& "#(lf)| extend Tactics = tostring(AdditionalData.tactics)"
						& "#(lf)| extend ResolutionHours = iff(isnotnull(ClosedTime), datetime_diff('hour', ClosedTime, CreatedTime), int(null))"
						& "#(lf)| extend CreatedDate = bin(CreatedTime, 1d)"
						& "#(lf)| project IncidentName, Title, Severity, SeveritySort, Status, Classification, IncidentUrl, CreatedTime, CreatedDate, LastModifiedTime, ClosedTime, Owner, AlertsCount, Tactics, ClientWorkspace, ResolutionHours",
					Source = AzureLogAnalytics.Contents(
						CentralWorkspaceId,
						[Query = KQL, Timeout = #duration(0, 0, 4, 0)]
					),
					Typed = Table.TransformColumnTypes(Source, {
						{"CreatedTime",      type datetime},
						{"CreatedDate",      type datetime},
						{"LastModifiedTime", type datetime},
						{"ClosedTime",       type datetime},
						{"AlertsCount",      Int64.Type},
						{"SeveritySort",     Int64.Type},
						{"ResolutionHours",  type number}
					})
				in
					Typed

	annotation PBI_ResultType = Table

