		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition AzureActivityEvents = m
		mode: import
		source =
				let
					KQL = fnBuildUnion("AzureActivity")
						& "#(lf)| where TimeGenerated > ago(90d)"
						& "#(lf)| where CategoryValue in (""Administrative"", ""Security"", ""Policy"")"
						& "#(lf)| where ActivityStatusValue in (""Success"", ""Failure"")"
						& "#(lf)| where OperationNameValue !has ""read"" and OperationNameValue !has ""/get"" and OperationNameValue !has ""/list"""
						& "#(lf)| project OperationName = OperationNameValue, Caller, ResourceGroup, ResourceType = tostring(split(OperationNameValue, ""/providers/"")[1]), ResultType = ActivityStatusValue, Category = CategoryValue, EventTime = TimeGenerated, EventDate = bin(TimeGenerated, 1d), ClientWorkspace",
					Source = fnQueryLogAnalytics(KQL),
					Typed = Table.TransformColumnTypes(Source, {
						{"EventTime", type datetime},
						{"EventDate", type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table

