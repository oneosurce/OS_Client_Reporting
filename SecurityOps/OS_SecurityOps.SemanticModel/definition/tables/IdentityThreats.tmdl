table IdentityThreats
	lineageTag: 44444444-0000-0000-0000-000000000001

	column EventType
		dataType: string
		lineageTag: 44444444-0001-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventType

		annotation SummarizationSetBy = User

	column UserPrincipalName
		dataType: string
		lineageTag: 44444444-0002-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: UserPrincipalName

		annotation SummarizationSetBy = User

	column IPAddress
		dataType: string
		lineageTag: 44444444-0003-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: IPAddress

		annotation SummarizationSetBy = User

	column Country
		dataType: string
		lineageTag: 44444444-0004-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = User

	column EventCount
		dataType: int64
		formatString: 0
		lineageTag: 44444444-0005-0000-0000-000000000001
		summarizeBy: sum
		sourceColumn: EventCount

		annotation SummarizationSetBy = User

	column EventDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: 44444444-0006-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: EventDate

		annotation SummarizationSetBy = User

	column ClientWorkspace
		dataType: string
		lineageTag: 44444444-0007-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: ClientWorkspace

		annotation SummarizationSetBy = User

	partition IdentityThreats = m
		mode: import
		source =
				let
					FailedSignInsKQL = fnBuildUnion("SigninLogs")
						& "#(lf)| where TimeGenerated > ago(30d)"
						& "#(lf)| where ResultType != 0"
						& "#(lf)| extend EventType = case(ResultType == 50126, ""Invalid Credentials"", ResultType == 50053, ""Account Locked"", ResultType == 50057, ""Account Disabled"", ""Failed Sign-in"")"
						& "#(lf)| summarize EventCount = count() by EventType, UserPrincipalName, IPAddress, Country = tostring(LocationDetails.countryOrRegion), EventDate = bin(TimeGenerated, 1d), ClientWorkspace",
					MFAEventsKQL = fnBuildUnion("AuditLogs")
						& "#(lf)| where TimeGenerated > ago(30d)"
						& "#(lf)| where OperationName in (""Disable Strong Authentication"", ""User registered security info"", ""User deleted security info"") or (OperationName == ""Sign-in activity"" and ResultDescription has ""MFA"" and ResultDescription has ""denied"")"
						& "#(lf)| extend EventType = case(OperationName has ""Disable"", ""MFA Disabled"", OperationName has ""deleted"", ""MFA Method Removed"", ""MFA Rejected"")"
						& "#(lf)| extend UPN = tostring(InitiatedBy.user.userPrincipalName)"
						& "#(lf)| summarize EventCount = count() by EventType, UserPrincipalName = UPN, IPAddress = """", Country = """", EventDate = bin(TimeGenerated, 1d), ClientWorkspace",
					BruteForceKQL = fnBuildUnion("SigninLogs")
						& "#(lf)| where TimeGenerated > ago(30d)"
						& "#(lf)| where ResultType != 0"
						& "#(lf)| summarize FailCount = count() by IPAddress, UserPrincipalName, bin(TimeGenerated, 1h), ClientWorkspace, Country = tostring(LocationDetails.countryOrRegion)"
						& "#(lf)| where FailCount >= 10"
						& "#(lf)| extend EventType = ""Brute Force"", EventCount = FailCount, EventDate = bin(TimeGenerated, 1d)"
						& "#(lf)| project EventType, UserPrincipalName, IPAddress, Country, EventCount, EventDate, ClientWorkspace",
					FailedSignIns = fnQueryLogAnalytics(CentralWorkspaceId, FailedSignInsKQL),
					MFAEvents    = fnQueryLogAnalytics(CentralWorkspaceId, MFAEventsKQL),
					BruteForce   = fnQueryLogAnalytics(CentralWorkspaceId, BruteForceKQL),
					Combined = Table.Combine({FailedSignIns, MFAEvents, BruteForce}),
					Typed = Table.TransformColumnTypes(Combined, {
						{"EventCount", Int64.Type},
						{"EventDate",  type datetime}
					})
				in
					Typed

	annotation PBI_ResultType = Table

