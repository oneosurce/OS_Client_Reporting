		annotation SummarizationSetBy = User

	partition Date = calculated
		mode: import
		source =
				VAR MinFromTickets = DATE ( YEAR ( MIN ( Tickets[Created Date] ) ), 1, 1 )
				VAR MinFromFlow = DATE ( YEAR ( MIN ( 'Ticket Flow'[Created Date] ) ), 1, 1 )
				VAR MinDate = MIN ( MinFromTickets, MinFromFlow )
				VAR MaxDate = DATE ( YEAR ( TODAY () ), 12, 31 )
				VAR CurQS = YEAR ( TODAY () ) * 4 + QUARTER ( TODAY () )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( MinDate, MaxDate ),
						"Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
						"Week Label", FORMAT ( [Date] - WEEKDAY ( [Date], 2 ) + 1, "MMM d" ),
						"Is Past", [Date] <= TODAY (),
						"Year", YEAR ( [Date] ),
						"Is YTD", YEAR ( [Date] ) = YEAR ( TODAY () ) && [Date] <= TODAY (),
						"Is This Quarter", YEAR ( [Date] ) = YEAR ( TODAY () ) && QUARTER ( [Date] ) = QUARTER ( TODAY () ) && [Date] <= TODAY (),
						"Month Sort", YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
						"Month Label", FORMAT ( [Date], "MMM" ),
						"Quarter Sort", YEAR ( [Date] ) * 4 + QUARTER ( [Date] ),
						"Quarter Label", "Q" & QUARTER ( [Date] ) & "-" & YEAR ( [Date] ),
						"Week of Quarter", "W" & FORMAT ( INT ( ( [Date] - DATE ( YEAR ( [Date] ), ( QUARTER ( [Date] ) - 1 ) * 3 + 1, 1 ) ) / 7 ) + 1, "00" ),
						"Is Recent Quarter",
							VAR qs = YEAR ( [Date] ) * 4 + QUARTER ( [Date] )
							RETURN ( qs = CurQS - 1 ) || ( qs = CurQS && [Date] <= TODAY () )
					)

	annotation PBI_ResultType = Table
