model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Tickets","Ticket Flow","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Tickets
ref table 'Ticket Flow'
ref table Date
ref table _Measures

ref cultureInfo en-US
