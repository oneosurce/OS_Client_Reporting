{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "hdrband",
  "position": {
    "x": 0,
    "y": 0,
    "z": 1,
    "width": 1280,
    "height": 86,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "shape",
    "objects": {
      "shape": [
        {
          "properties": {
            "shapeType": {
              "expr": {
                "Literal": {
                  "Value": "'rectangle'"
                }
              }
            },
            "fillCustomColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1B2A5B'"
                    }
                  }
                }
              }
            },
            "fillShow": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "roundEdge": {
              "expr": {
                "Literal": {
                  "Value": "0"
                }
              }
            }
          }
        }
      ],
      "outline": [
        {
          "properties": {
            "lineTransparency": {
              "expr": {
                "Literal": {
                  "Value": "100"
                }
              }
            }
          }
        }
      ]
    }
  }
}