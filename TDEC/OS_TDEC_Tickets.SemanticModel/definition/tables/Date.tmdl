		annotation SummarizationSetBy = User
	partition Date = calculated
		mode: import
		source =
				VAR MinDate = DATE ( YEAR ( MIN ( Tickets[Created Date] ) ), 1, 1 )
				VAR MaxDate = DATE ( YEAR ( TODAY () ), 12, 31 )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( MinDate, MaxDate ),
						"Year", YEAR ( [Date] ),
						"Quarter", "Q" & QUARTER ( [Date] ),
						"Year Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
						"Month Number", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "MMM" ),
						"Year Month", FORMAT ( [Date], "yyyy-MM" ),
						"Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
						"Week Label", FORMAT ( [Date] - WEEKDAY ( [Date], 2 ) + 1, "MMM d" ),
						"Day of Week", FORMAT ( [Date], "ddd" ),
						"Day of Week Number", WEEKDAY ( [Date], 2 ),
						"Is Past", [Date] <= TODAY ()
					)

	annotation PBI_ResultType = Table
