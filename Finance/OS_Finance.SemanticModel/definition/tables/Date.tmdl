table Date
	lineageTag: f0000005-0000-4001-9005-000000000001
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: f0000005-0000-4001-9005-000000000002
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		formatString: 0
		lineageTag: f0000005-0000-4001-9005-000000000003
		summarizeBy: none
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f0000005-0000-4001-9005-000000000004
		summarizeBy: none
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		lineageTag: f0000005-0000-4001-9005-000000000005
		summarizeBy: none
		sortByColumn: 'Month Number'
		sourceColumn: [Month]

		annotation SummarizationSetBy = User

	column 'Year Month'
		dataType: string
		lineageTag: f0000005-0000-4001-9005-000000000006
		summarizeBy: none
		sortByColumn: 'Year Month Sort'
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = User

	column 'Year Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f0000005-0000-4001-9005-000000000007
		summarizeBy: none
		sourceColumn: [Year Month Sort]

		annotation SummarizationSetBy = User

	column 'Month Label'
		dataType: string
		lineageTag: f0000005-0000-4001-9005-000000000008
		summarizeBy: none
		sortByColumn: 'Year Month Sort'
		sourceColumn: [Month Label]

		annotation SummarizationSetBy = User

	partition Date = calculated
		mode: import
		source =
				VAR MinDate = DATE ( YEAR ( MIN ( Invoices[Invoice Date] ) ), 1, 1 )
				VAR MaxDate = DATE ( YEAR ( TODAY () ), 12, 31 )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( MinDate, MaxDate ),
						"Year", YEAR ( [Date] ),
						"Month Number", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "MMM" ),
						"Year Month", FORMAT ( [Date], "yyyy-MM" ),
						"Year Month Sort", YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
						"Month Label", FORMAT ( [Date], "MMM yyyy" )
					)

	annotation PBI_ResultType = Table
