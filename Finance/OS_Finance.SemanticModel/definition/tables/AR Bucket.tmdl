	column Bucket
		isNameInferred
		dataType: string
		summarizeBy: none
		sortByColumn: Sort
		sourceColumn: [Bucket]
		lineageTag: f0000007-0000-4001-9007-000000000002

	column Sort
		isNameInferred
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Sort]
		lineageTag: f0000007-0000-4001-9007-000000000003

	partition 'AR Bucket' = calculated
