model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Invoices","Payments","Customers","Ticket Volume","Date Range","AR Bucket","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Invoices
ref table Payments
ref table Customers
ref table 'Ticket Volume'
ref table Date
ref table 'Date Range'
ref table 'AR Bucket'
ref table _Measures

ref cultureInfo en-US
